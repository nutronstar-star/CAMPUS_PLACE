<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 580 240" width="100%" height="100%" aria-label="CampusPlace">
  <defs>
    <linearGradient id="b-pin" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#3B82F6"/>
      <stop offset="100%" stop-color="#1E3A8A"/>
    </linearGradient>
    <linearGradient id="b-cap" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7DD3FC"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>
    <linearGradient id="b-arrow" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#059669"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <linearGradient id="b-place" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0284C7"/>
      <stop offset="100%" stop-color="#0D9488"/>
    </linearGradient>
    <linearGradient id="b-gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FBBF24"/>
      <stop offset="100%" stop-color="#D97706"/>
    </linearGradient>
    <filter id="b-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#0F172A" flood-opacity="0.10"/>
    </filter>
  </defs>

  <!-- ICON -->
  <g transform="translate(20, 10)">
    <circle cx="100" cy="26" r="2.5" fill="#0284C7"/>
    <circle cx="20" cy="130" r="3" fill="#0284C7"/>
    <circle cx="20" cy="130" r="6" fill="none" stroke="#0284C7" stroke-width="0.8" opacity="0.4"/>
    <circle cx="180" cy="130" r="3" fill="#10B981"/>
    <circle cx="180" cy="130" r="6" fill="none" stroke="#10B981" stroke-width="0.8" opacity="0.4"/>

    <path d="M100 55 C 148 55, 178 88, 178 128 C 178 168, 132 195, 100 212 C 68 195, 22 168, 22 128 C 22 88, 52 55, 100 55 Z"
          fill="url(#b-pin)" stroke="#BAE6FD" stroke-width="1.5" filter="url(#b-shadow)"/>

    <path d="M100 88 L 134 128 L 114 128 L 114 174 L 86 174 L 86 128 L 66 128 Z" fill="url(#b-arrow)"/>
    <line x1="92" y1="148" x2="108" y2="148" stroke="#064E3B" stroke-width="2" stroke-linecap="round"/>
    <line x1="92" y1="160" x2="108" y2="160" stroke="#064E3B" stroke-width="2" stroke-linecap="round"/>

    <path d="M100 10 L 36 42 L 100 64 L 164 42 Z" fill="url(#b-cap)" stroke="#0284C7" stroke-width="0.8"/>
    <path d="M70 48 L 70 60 C 70 68, 82 74, 100 74 C 118 74, 130 68, 130 60 L 130 48" fill="none" stroke="#0284C7" stroke-width="1.8" stroke-linecap="round"/>
    <line x1="100" y1="10" x2="100" y2="64" stroke="#E0F2FE" stroke-width="0.6" opacity="0.7"/>

    <circle cx="100" cy="32" r="3" fill="url(#b-gold)"/>
    <path d="M100 32 Q 132 38, 148 62 L 148 82" stroke="url(#b-gold)" stroke-width="2" fill="none" stroke-linecap="round"/>
    <polygon points="144,82 152,82 155,93 141,93" fill="url(#b-gold)"/>
  </g>

  <!-- TEXT -->
  <g transform="translate(240, 0)">
    <g transform="translate(0, 62)">
      <rect x="0" y="0" width="222" height="24" rx="12" fill="#F0F9FF" stroke="#BAE6FD"/>
      <circle cx="12" cy="12" r="3.5" fill="#10B981"/>
      <text x="22" y="16" font-family="system-ui, -apple-system, 'Segoe UI', sans-serif" font-size="9.5" font-weight="700" fill="#0369A1" letter-spacing="1.6">NATIONAL RECRUITMENT PORTAL</text>
    </g>

    <text x="0" y="142" font-family="system-ui, -apple-system, 'Segoe UI', sans-serif" font-size="52" font-weight="800" letter-spacing="-1.2">
      <tspan fill="#0F172A">Campus</tspan><tspan fill="url(#b-place)">Place</tspan>
    </text>

    <text x="2" y="172" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#64748B" letter-spacing="3">NATIONAL PLACEMENT MANAGEMENT SYSTEM</text>

    <line x1="2" y1="190" x2="330" y2="190" stroke="#E2E8F0" stroke-width="1"/>
    <line x1="2" y1="190" x2="60" y2="190" stroke="#0284C7" stroke-width="2.5"/>

    <g transform="translate(2, 205)">
      <g>
        <rect x="0" y="0" width="90" height="22" rx="6" fill="#F8FAFC" stroke="#E2E8F0"/>
        <circle cx="9" cy="11" r="2.5" fill="#0284C7"/>
        <text x="16" y="15" font-family="system-ui" font-size="9" font-weight="600" fill="#475569">All India</text>
      </g>
      <g transform="translate(98, 0)">
        <rect x="0" y="0" width="100" height="22" rx="6" fill="#F8FAFC" stroke="#E2E8F0"/>
        <circle cx="9" cy="11" r="2.5" fill="#0D9488"/>
        <text x="16" y="15" font-family="system-ui" font-size="9" font-weight="600" fill="#475569">Recruiters</text>
      </g>
      <g transform="translate(206, 0)">
        <rect x="0" y="0" width="106" height="22" rx="6" fill="#F8FAFC" stroke="#E2E8F0"/>
        <circle cx="9" cy="11" r="2.5" fill="#F59E0B"/>
        <text x="16" y="15" font-family="system-ui" font-size="9" font-weight="600" fill="#475569">DPDP Compliant</text>
      </g>
    </g>
  </g>
</svg>