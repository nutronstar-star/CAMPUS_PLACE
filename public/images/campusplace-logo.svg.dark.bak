<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 920 320" width="100%" height="100%" aria-label="CampusPlace Logo">
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B0F19" />
      <stop offset="50%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#090D16" />
    </linearGradient>
    <linearGradient id="capLeftGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8" /><stop offset="100%" stop-color="#2563EB" />
    </linearGradient>
    <linearGradient id="capRightGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2563EB" /><stop offset="100%" stop-color="#1D4ED8" />
    </linearGradient>
    <linearGradient id="pinBodyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1E293B" /><stop offset="60%" stop-color="#0F172A" /><stop offset="100%" stop-color="#0284C7" />
    </linearGradient>
    <linearGradient id="arrowGrad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#059669" /><stop offset="45%" stop-color="#10B981" /><stop offset="100%" stop-color="#38BDF8" />
    </linearGradient>
    <linearGradient id="textPlaceGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38BDF8" /><stop offset="50%" stop-color="#2DD4BF" /><stop offset="100%" stop-color="#34D399" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE047" /><stop offset="50%" stop-color="#F59E0B" /><stop offset="100%" stop-color="#D97706" />
    </linearGradient>
    <linearGradient id="nodeLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.1" />
      <stop offset="50%" stop-color="#38BDF8" stop-opacity="0.5" />
      <stop offset="100%" stop-color="#10B981" stop-opacity="0.1" />
    </linearGradient>
    <filter id="badgeGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="16" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <filter id="softShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#000000" flood-opacity="0.5" />
    </filter>
  </defs>
  <rect x="8" y="8" width="904" height="304" rx="24" fill="url(#bgGradient)" stroke="#1E293B" stroke-width="1.5" />
  <circle cx="160" cy="160" r="85" fill="#0284C7" opacity="0.18" filter="url(#badgeGlow)" />
  <circle cx="160" cy="195" r="45" fill="#10B981" opacity="0.15" filter="url(#badgeGlow)" />
  <g transform="translate(5, 0)">
    <ellipse cx="155" cy="160" rx="98" ry="76" fill="none" stroke="url(#nodeLineGrad)" stroke-width="1.5" stroke-dasharray="4 6" />
    <circle cx="155" cy="84" r="3.5" fill="#38BDF8" />
    <circle cx="68" cy="188" r="4" fill="#38BDF8" />
    <circle cx="68" cy="188" r="7" fill="none" stroke="#38BDF8" stroke-opacity="0.4" stroke-width="1" />
    <circle cx="242" cy="188" r="4" fill="#34D399" />
    <circle cx="242" cy="188" r="7" fill="none" stroke="#34D399" stroke-opacity="0.4" stroke-width="1" />
    <path d="M 155 125 C 192 125, 218 152, 218 184 C 218 214, 185 244, 155 264 C 125 244, 92 214, 92 184 C 92 152, 118 125, 155 125 Z" fill="url(#pinBodyGrad)" stroke="#334155" stroke-width="1.5" filter="url(#softShadow)" />
    <path d="M 155 146 L 182 178 L 167 178 L 167 228 L 143 228 L 143 178 L 128 178 Z" fill="url(#arrowGrad)" filter="url(#softShadow)" />
    <line x1="148" y1="202" x2="162" y2="202" stroke="#0F172A" stroke-width="2.5" stroke-linecap="round" />
    <line x1="148" y1="216" x2="162" y2="216" stroke="#0F172A" stroke-width="2.5" stroke-linecap="round" />
    <path d="M 124 106 C 124 118, 140 126, 155 126 C 170 126, 186 118, 186 106 L 186 114 C 186 126, 170 134, 155 134 C 140 134, 124 126, 124 114 Z" fill="#0F172A" stroke="#334155" stroke-width="1" />
    <path d="M 155 70 L 86 102 L 155 124 Z" fill="url(#capLeftGrad)" />
    <path d="M 155 70 L 224 102 L 155 124 Z" fill="url(#capRightGrad)" />
    <line x1="155" y1="70" x2="155" y2="124" stroke="#93C5FD" stroke-width="1" stroke-opacity="0.6" />
    <circle cx="155" cy="97" r="4.5" fill="url(#goldGrad)" />
    <path d="M 155 97 C 182 100, 214 112, 218 132 L 218 152" fill="none" stroke="url(#goldGrad)" stroke-width="2.5" stroke-linecap="round" />
    <polygon points="214,152 222,152 225,166 211,166" fill="url(#goldGrad)" />
  </g>
  <g transform="translate(300, 0)">
    <g transform="translate(0, 68)">
      <rect x="0" y="0" width="232" height="26" rx="13" fill="#1E293B" stroke="#334155" stroke-width="1" />
      <circle cx="14" cy="13" r="4.5" fill="#10B981" />
      <text x="26" y="17" fill="#94A3B8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="10" font-weight="700" letter-spacing="1.8">NATIONAL RECRUITMENT PORTAL</text>
    </g>
    <text x="0" y="152" font-family="-apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif" font-size="58" font-weight="800" letter-spacing="-1">
      <tspan fill="#F8FAFC">Campus</tspan><tspan fill="url(#textPlaceGrad)">Place</tspan>
    </text>
    <circle cx="396" cy="120" r="5" fill="#10B981" />
    <text x="2" y="184" fill="#94A3B8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13.5" font-weight="600" letter-spacing="3.2">NATIONAL PLACEMENT MANAGEMENT SYSTEM</text>
    <line x1="2" y1="202" x2="520" y2="202" stroke="#1E293B" stroke-width="1.5" />
    <line x1="2" y1="202" x2="80" y2="202" stroke="#0284C7" stroke-width="2" />
    <g transform="translate(2, 220)">
      <g transform="translate(0, 0)">
        <rect x="0" y="0" width="128" height="24" rx="6" fill="#111C30" stroke="#1E293B" stroke-width="1" />
        <circle cx="10" cy="12" r="3" fill="#38BDF8" />
        <text x="18" y="16" fill="#94A3B8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="10" font-weight="600">All India Colleges</text>
      </g>
      <g transform="translate(136, 0)">
        <rect x="0" y="0" width="134" height="24" rx="6" fill="#111C30" stroke="#1E293B" stroke-width="1" />
        <circle cx="10" cy="12" r="3" fill="#2DD4BF" />
        <text x="18" y="16" fill="#94A3B8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="10" font-weight="600">Direct Recruiter Hub</text>
      </g>
      <g transform="translate(278, 0)">
        <rect x="0" y="0" width="124" height="24" rx="6" fill="#111C30" stroke="#1E293B" stroke-width="1" />
        <circle cx="10" cy="12" r="3" fill="#F59E0B" />
        <text x="18" y="16" fill="#94A3B8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" font-size="10" font-weight="600">DPDP Compliant</text>
      </g>
    </g>
  </g>
</svg>